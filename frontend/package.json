{
  "name": "geohazard-monitor-prevention-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "verify:init": "tsc -p tsconfig.verify.json && node -e \"require('fs').writeFileSync('.verify-out/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node .verify-out/scripts/verify-init.js && node .verify-out/scripts/verify-store.js"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
