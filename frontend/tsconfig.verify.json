{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".verify-out",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": ["scripts/**/*.ts", "src/data/**/*.ts", "src/api/**/*.ts"]
}
